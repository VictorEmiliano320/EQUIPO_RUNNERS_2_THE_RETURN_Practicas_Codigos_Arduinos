// Programa: Operación lógica AND con dos entradas digitales
// Entradas: Pin 2 y Pin 3
// Salida: Pin 13 (LED incrustado)

const int entrada1 = 2;   // Primer botón o señal digital
const int entrada2 = 3;   // Segundo botón o señal digital
const int salida   = 13;  // LED incrustado en la placa
const int salidaSum   = 5; //Salida para LED de suma
const int salidaRes   = 6; //Salida para LED de resta

void setup() {
  pinMode(entrada1, INPUT);   // Configura pin 2 como entrada
  pinMode(entrada2, INPUT);   // Configura pin 3 como entrada
  pinMode(salida, OUTPUT);    // Configura pin 13 como salida
  pinMode(salidaSum, OUTPUT); // Configura pin 5 como salida
  pinMode(salidaRes, OUTPUT); // Configura pin 6 como salida

  Serial.begin(9600);         // Inicializa comunicación serial
}

void loop() {
  int valor1 = digitalRead(entrada1);  // Lee estado de la primera entrada
  int valor2 = digitalRead(entrada2);  // Lee estado de la segunda entrada

  // Operación lógica AND (MULTIPLICACIÓN)
  Serial.print("El resultado de la multiplicación (AND) es: ");
  if (valor1 && valor2 ) {
    digitalWrite(salida, HIGH);   // Enciende LED si ambas entradas están en HIGH
    Serial.println("1");
  } else {
    digitalWrite(salida, LOW);    // Apaga LED en cualquier otro caso
    Serial.println("0");
  }

  // Operación lógica XOR y AND (SUMA)
  Serial.print("El resultado de la suma (XOR y AND) es: ");
  if (valor1 ^ valor2 ) {
    digitalWrite(salidaSum, HIGH);   // Enciende LED si ambas entradas están en HIGH
    Serial.println("1");
  } else {
    digitalWrite(salidaSum, LOW);    // Apaga LED en cualquier otro caso
    Serial.println("0");
  }
  if (valor1 && valor2 ) {
    digitalWrite(salidaSum, HIGH);   // Enciende LED si ambas entradas están en HIGH
    Serial.println("1");
  } else {
    digitalWrite(salidaSum, LOW);    // Apaga LED en cualquier otro caso
    Serial.println("0");
  }

  // Operación lógica XOR y -pq (RESTA)
  Serial.print("El resultado de la resta (XOR y -pq) es: ");
  if (valor1 ^ valor2 ) {
    digitalWrite(salidaRes, HIGH);   // Enciende LED si ambas entradas están en HIGH
    Serial.println("1");
  } else {
    digitalWrite(salidaRes, LOW);    // Apaga LED en cualquier otro caso
    Serial.println("0");
  }
  if (valor1 == 0 && valor2 == 1) {
    digitalWrite(salidaRes, HIGH);   // Enciende LED si ambas entradas están en HIGH
    Serial.println("1");
  } else {
    digitalWrite(salidaRes, LOW);    // Apaga LED en cualquier otro caso
    Serial.println("0");
  }

  delay(1200);

}
